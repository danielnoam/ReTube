<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup rules (android:dataExtractionRules). Same exclusions as backup_rules.xml
    (the Android 6-11 file) except that one drops all of global_prefs/; see there for each path.
    Both cloud backup and device-to-device transfer leave the sign-in secrets and the player-route
    identity caches behind.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="global_prefs/media_service_account_data" />
        <exclude domain="file" path="global_prefs/oauth2_account_data" />
        <exclude domain="sharedpref" path="AuthTokenCache.xml" />
        <exclude domain="sharedpref" path="newtube_player_routes.xml" />
        <exclude domain="sharedpref" path="retube_local_stats.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="global_prefs/media_service_account_data" />
        <exclude domain="file" path="global_prefs/oauth2_account_data" />
        <exclude domain="sharedpref" path="AuthTokenCache.xml" />
        <exclude domain="sharedpref" path="newtube_player_routes.xml" />
        <exclude domain="sharedpref" path="retube_local_stats.xml" />
    </device-transfer>
</data-extraction-rules>
