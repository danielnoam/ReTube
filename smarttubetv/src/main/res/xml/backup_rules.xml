<?xml version="1.0" encoding="utf-8"?>
<!--
    Android Auto Backup rules for Android 6-11 (android:fullBackupContent).
    Android 12+ reads data_extraction_rules.xml instead; keep the two lists identical.

    Everything is backed up except the files that hold sign-in secrets:
    - files/global_prefs/media_service_account_data: YouTube accounts with their OAuth
      refresh tokens (GlobalPreferences.setMediaServiceAccountData -> setData writes one
      plain file per key under files/global_prefs/, not shared_prefs).
    - files/global_prefs/oauth2_account_data: the Google Drive backup sign-in (refresh token).
    - shared_prefs/AuthTokenCache.xml: YouTubeSignInService's cached access header, which
      also stores the refresh token.
    - shared_prefs/newtube_player_routes.xml: player-route caches that hold YouTube visitor ids
      (bot walls, embed and kept playback identities). Nothing in it is a setting.
    files/global_prefs/media_service_data (visitor cookie, device ids, hidden-content switches)
    stays in for the switches; RestoredIdentity drops its identity part on the first start after
    a restore. A restored or transferred install therefore comes back signed out, with a new
    anonymous YouTube identity.
    This file excludes all of global_prefs/ (Android 6-11 only), which also drops language, country
    and DNS choices on those versions; data_extraction_rules.xml keeps them.
-->
<full-backup-content>
    <exclude domain="file" path="global_prefs/" />
    <exclude domain="sharedpref" path="AuthTokenCache.xml" />
    <exclude domain="sharedpref" path="newtube_player_routes.xml" />
</full-backup-content>
