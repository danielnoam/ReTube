<?xml version="1.0" encoding="utf-8"?>
<!--
  ReTube adaptive-icon background (stmobile flavor).

  Full-bleed 108x108 layer; the launcher applies its own mask (circle / rounded
  square / squircle) on top. Near-black base with a pure-black lower-right wedge
  for depth without a gradient tag (keeps aapt happy on the pinned toolchain).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#121212"
        android:pathData="M0,0h108v108h-108z" />
    <path
        android:fillColor="#000000"
        android:pathData="M108,0 L108,108 L0,108 Z" />
</vector>
