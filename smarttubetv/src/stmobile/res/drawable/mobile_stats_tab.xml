<?xml version="1.0" encoding="utf-8"?>
<!-- Day / Week / Month on the Stats page: the picked one is filled. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mobile_color_inverse_surface" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mobile_color_pill" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
