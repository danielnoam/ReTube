    <string name="mobile_stats_consent_title">Keep stats on this phone?</string>
    <string name="mobile_stats_consent_body">ReTube can count how long you watch, which channels you watch most and what you download, and show it here by day, week and month.\n\nStats are saved only on this phone. They are never uploaded or sent to YouTube; only your own backups include them. You can turn them off or clear them anytime.</string>
    <string name="mobile_stats_consent_yes">Keep stats</string>
    <string name="mobile_stats_consent_no">No thanks</string>

    <string name="mobile_stats_off_title">Stats are off</string>
    <string name="mobile_stats_off_body">Nothing you watch or download is being counted. Turn stats on to see your watch time by day, week and month. They stay on this phone.</string>
